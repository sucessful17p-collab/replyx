# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/relaychat.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=12
COOKIE_SECURE=false
# Email verification (optional locally; codes are logged only when SMTP is not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RelayChat X <noreply@example.com>
SMTP_STARTTLS=true
# SMS provider: Twilio REST API (optional; demo code is logged only when not configured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# WebAuthn/passkeys: APP_BASE_URL must be HTTPS in production
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=RelayChat X
